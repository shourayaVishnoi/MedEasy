# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for deployment.
# Never commit real values. Leave a key empty to keep that feature off.

# --- App -------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=MedEasy

# --- Supabase (auth, database, private storage) ----------------------
# Without these, sign-in/sign-up show a "not configured" notice and only
# the browser-only demo works. With them, signed-in accounts are saved in Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by the reminder cron job. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider (optional) ------------------------------------------
# Enables "Ask AI provider" explanations and image OCR (/api/ocr).
# The built-in rule-based explainer and assistant work without it.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# When Supabase is configured, AI routes need a signed-in user unless this is true.
AI_ALLOW_ANONYMOUS=false

# --- Reminders --------------------------------------------------------
# Random string; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Email reminders (Resend)
RESEND_API_KEY=
EMAIL_FROM="MedEasy <reminders@your-domain.example>"

# Browser push reminders (Web Push). Generate once with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:reminders@your-domain.example

# SMS reminders (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
